@@ -336 +336,6 @@ func NewXCTAttachment(object map[string]interface{}, objects []interface{}) inte
-	userInfo, _ := extractDictionary(objects[object["userInfo"].(plist.UID)].(map[string]interface{}), objects, 0)
+	userInfo, err := extractAttachmentUserInfo(object, objects)
+	if err != nil {
+		// Decoder factories have no error return. Unarchive converts this into
+		// its normal decode error; malformed metadata must not be discarded.
+		panic(fmt.Errorf("XCTAttachment.userInfo: %w", err))
+	}
@@ -351,0 +357,41 @@ func NewXCTAttachment(object map[string]interface{}, objects []interface{}) inte
+func extractAttachmentUserInfo(object map[string]interface{}, objects []interface{}) (map[string]interface{}, error) {
+	raw, present := object["userInfo"]
+	if !present || raw == nil {
+		return nil, nil
+	}
+	ref, ok := raw.(plist.UID)
+	if !ok {
+		return nil, fmt.Errorf("must be an object UID, got %T", raw)
+	}
+	if ref == 0 {
+		return nil, nil
+	}
+	if uint64(ref) >= uint64(len(objects)) {
+		return nil, fmt.Errorf("object UID %d out of range", ref)
+	}
+	value := objects[ref]
+	if value == nil {
+		return nil, nil
+	}
+	if sentinel, ok := value.(string); ok && sentinel == null {
+		return nil, nil
+	}
+	dictionary, ok := value.(map[string]interface{})
+	if !ok {
+		return nil, fmt.Errorf("must reference NSDictionary, got %T", value)
+	}
+	classRef, ok := dictionary[class].(plist.UID)
+	if !ok || uint64(classRef) >= uint64(len(objects)) {
+		return nil, fmt.Errorf("dictionary class UID is invalid")
+	}
+	classObject, ok := objects[classRef].(map[string]interface{})
+	if !ok {
+		return nil, fmt.Errorf("dictionary class is not an object")
+	}
+	name, _ := classObject[className].(string)
+	if name != nsDictionary && name != nsMutableDictionary {
+		return nil, fmt.Errorf("must reference NSDictionary, got class %q", name)
+	}
+	return extractDictionary(dictionary, objects, 0)
+}
+
