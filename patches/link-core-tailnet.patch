+// newDeflatedZipHeader is newZipHeader for a file whose data is DEFLATE
+// compressed. Sizes and CRC stay in the local header because the stream has
+// no data descriptors.
+func newDeflatedZipHeader(compressedSize uint32, size uint32, crc32 uint32, name string) (zipHeader, []byte, []byte) {
+	header, nameBytes, extra := newZipHeader(size, crc32, name)
+	header.compressionMethod = 8 // DEFLATE
+	header.compressedSize = compressedSize
+	return header, nameBytes, extra
+}
