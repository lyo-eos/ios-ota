+// fileZipEntry returns the header of a file entry and the data to send after
+// it: the deflated file when that is smaller, otherwise the file itself.
+func fileZipEntry(file *os.File, size int64, name string, hasher hash.Hash32, spool *deflateSpool) (zipHeader, []byte, []byte, io.Reader, error) {
+	if spool == nil {
+		crc, err := calculateCrc32(file, hasher)
+		if err != nil {
+			return zipHeader{}, nil, nil, nil, err
+		}
+		_, err = file.Seek(0, io.SeekStart)
+		header, nameBytes, extra := newZipHeader(uint32(size), crc, name)
+		return header, nameBytes, extra, file, err
+	}
+	crc, compressed, compressedSize, err := spool.deflate(file, hasher)
+	if err != nil {
+		return zipHeader{}, nil, nil, nil, err
+	}
+	if compressedSize < size {
+		header, nameBytes, extra := newDeflatedZipHeader(uint32(compressedSize), uint32(size), crc, name)
+		return header, nameBytes, extra, compressed, nil
+	}
+	// Already compressed data such as images and audio does not shrink.
+	_, err = file.Seek(0, io.SeekStart)
+	header, nameBytes, extra := newZipHeader(uint32(size), crc, name)
+	return header, nameBytes, extra, file, err
+}
+
+// deflateSpool compresses file entries before they are sent. The local header
+// must carry the compressed size, so each file is deflated into a temporary
+// file first and sent from there; memory use stays flat for large binaries.
+type deflateSpool struct {
+	file     *os.File
+	buffered *bufio.Writer
+	writer   *flate.Writer
+}
+
+func newDeflateSpool(dir string) (*deflateSpool, error) {
+	file, err := os.CreateTemp(dir, "deflate-spool")
+	if err != nil {
+		return nil, err
+	}
+	buffered := bufio.NewWriterSize(file, 1<<20)
+	// BestSpeed compresses app binaries at ~200 MB/s, far faster than the link
+	// they are sent over; higher levels save only a few percent more.
+	writer, err := flate.NewWriter(buffered, flate.BestSpeed)
+	if err != nil {
+		file.Close()
+		return nil, err
+	}
+	return &deflateSpool{file: file, buffered: buffered, writer: writer}, nil
+}
+
+func (s *deflateSpool) Close() error {
+	return s.file.Close()
+}
+
+// deflate compresses src into the spool and returns the CRC-32 of src, a
+// reader over the compressed data and its size. The spool is overwritten from
+// the start each time; the reader stops before stale data of earlier files.
+func (s *deflateSpool) deflate(src io.Reader, hasher hash.Hash32) (uint32, io.Reader, int64, error) {
+	if _, err := s.file.Seek(0, io.SeekStart); err != nil {
+		return 0, nil, 0, err
+	}
+	s.buffered.Reset(s.file)
+	s.writer.Reset(s.buffered)
+	hasher.Reset()
+	if _, err := io.Copy(io.MultiWriter(hasher, s.writer), src); err != nil {
+		return 0, nil, 0, err
+	}
+	if err := s.writer.Close(); err != nil {
+		return 0, nil, 0, err
+	}
+	if err := s.buffered.Flush(); err != nil {
+		return 0, nil, 0, err
+	}
+	compressedSize, err := s.file.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return 0, nil, 0, err
+	}
+	if _, err := s.file.Seek(0, io.SeekStart); err != nil {
+		return 0, nil, 0, err
+	}
+	return hasher.Sum32(), io.LimitReader(s.file, compressedSize), compressedSize, nil
+}
