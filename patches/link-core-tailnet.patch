diff --git a/ios/appservice/context_test.go b/ios/appservice/context_test.go
new file mode 100644
index 0000000..1aa96d4
--- /dev/null
+++ b/ios/appservice/context_test.go
@@ -0,0 +1,54 @@
+package appservice
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/danielpaulus/go-ios/ios"
+)
+
+func TestCancellationInterruptsAppServiceHandshake(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	closed := make(chan struct{})
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			close(closed)
+			return
+		}
+		defer conn.Close()
+		io.Copy(io.Discard, conn)
+		close(closed)
+	}()
+	device := ios.DeviceEntry{Address: "127.0.0.1", Rsd: ios.RsdHandshakeResponse{Services: map[string]ios.RsdServiceEntry{"com.apple.coredevice.appservice": {Port: uint32(listener.Addr().(*net.TCPAddr).Port)}}}}
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	returned := make(chan error, 1)
+	go func() {
+		service, err := NewWithContext(ctx, device)
+		if service != nil {
+			service.Close()
+		}
+		returned <- err
+	}()
+	select {
+	case err := <-returned:
+		if err == nil {
+			t.Fatal("stalled handshake succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled constructor stayed blocked")
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("constructor leaked its socket")
+	}
+}
