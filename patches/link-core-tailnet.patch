@@ -385,0 +407,28 @@ func (t *TestListener) reset() {
+
+// resultSnapshot seals callbacks after the final test-plan event and returns
+// detached slices, so daemon serialization never races a DTX reader.
+func (t *TestListener) resultSnapshot() ([]TestSuite, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.sealed = true
+	suites := append([]TestSuite(nil), t.TestSuites...)
+	for i := range suites {
+		suites[i].TestCases = append([]TestCase(nil), suites[i].TestCases...)
+		for j := range suites[i].TestCases {
+			suites[i].TestCases[j].Attachments = append([]TestAttachment(nil), suites[i].TestCases[j].Attachments...)
+		}
+	}
+	return suites, t.err
+}
+
+// DTX callbacks and runner stdio may write the same destination concurrently.
+type synchronizedTestWriter struct {
+	mu     *sync.Mutex
+	writer io.Writer
+}
+
+func (w synchronizedTestWriter) Write(data []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.writer.Write(data)
+}
