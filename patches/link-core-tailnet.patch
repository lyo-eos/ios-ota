diff --git a/ios/zipconduit/deflate_test.go b/ios/zipconduit/deflate_test.go
new file mode 100644
index 0000000..eb9e21d
--- /dev/null
+++ b/ios/zipconduit/deflate_test.go
@@ -0,0 +1,163 @@
+package zipconduit
+
+import (
+	"bytes"
+	"compress/flate"
+	"encoding/binary"
+	"hash/crc32"
+	"io"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/danielpaulus/go-ios/ios"
+)
+
+type recordingConn struct {
+	sent      bytes.Buffer
+	responses io.Reader
+}
+
+func (c *recordingConn) Read(p []byte) (int, error)  { return c.responses.Read(p) }
+func (c *recordingConn) Write(p []byte) (int, error) { return c.sent.Write(p) }
+func (c *recordingConn) Close() error                { return nil }
+
+type streamEntry struct {
+	name           string
+	flags          uint16
+	method         uint16
+	crc            uint32
+	compressedSize uint32
+	size           uint32
+	data           []byte
+}
+
+// parseStream splits what was sent to the device into its zip entries.
+func parseStream(t *testing.T, stream []byte) []streamEntry {
+	t.Helper()
+	if len(stream) < 4 {
+		t.Fatalf("stream too short: %d bytes", len(stream))
+	}
+	initLength := binary.BigEndian.Uint32(stream)
+	stream = stream[4+initLength:]
+	var entries []streamEntry
+	for {
+		if bytes.Equal(stream, centralDirectoryHeader) {
+			return entries
+		}
+		if len(stream) < 30 || binary.LittleEndian.Uint32(stream) != 0x04034b50 {
+			t.Fatalf("expected a local file header after %d entries", len(entries))
+		}
+		entry := streamEntry{
+			flags:          binary.LittleEndian.Uint16(stream[6:]),
+			method:         binary.LittleEndian.Uint16(stream[8:]),
+			crc:            binary.LittleEndian.Uint32(stream[14:]),
+			compressedSize: binary.LittleEndian.Uint32(stream[18:]),
+			size:           binary.LittleEndian.Uint32(stream[22:]),
+		}
+		nameLength := int(binary.LittleEndian.Uint16(stream[26:]))
+		extraLength := int(binary.LittleEndian.Uint16(stream[28:]))
+		stream = stream[30:]
+		if len(stream) < nameLength+extraLength+int(entry.compressedSize) {
+			t.Fatalf("entry %d is truncated", len(entries))
+		}
+		entry.name = string(stream[:nameLength])
+		stream = stream[nameLength+extraLength:]
+		entry.data = stream[:entry.compressedSize]
+		stream = stream[entry.compressedSize:]
+		entries = append(entries, entry)
+	}
+}
+
+func TestSendDirectoryDeflatesFilesThatShrink(t *testing.T) {
+	app := filepath.Join(t.TempDir(), "Test.app")
+	random := make([]byte, 256*1024)
+	rand.New(rand.NewSource(1)).Read(random)
+	files := map[string][]byte{
+		// Larger compressible file first, so the spool is reused for a smaller one.
+		"Frameworks/Engine.framework/Engine": bytes.Repeat([]byte("debug symbols and code "), 64*1024),
+		"Info.plist":                         []byte(strings.Repeat("<key>CFBundleIdentifier</key>\n", 40)),
+		"Assets.car":                         random,
+		"Empty":                              {},
+	}
+	for name, content := range files {
+		path := filepath.Join(app, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, content, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var responses bytes.Buffer
+	if err := ios.NewPlistCodecReadWriter(nil, &responses).Write(map[string]interface{}{"Status": "DataComplete"}); err != nil {
+		t.Fatal(err)
+	}
+	device := &recordingConn{responses: &responses}
+	conn := Connection{deviceConn: device, plistCodec: ios.NewPlistCodecReadWriter(device, device)}
+	if err := conn.SendFile(app); err != nil {
+		t.Fatalf("SendFile: %v", err)
+	}
+
+	wantMethods := map[string]uint16{
+		"Frameworks/Engine.framework/Engine": 8,
+		"Info.plist":                         8,
+		"Assets.car":                         0,
+		"Empty":                              0,
+		"META-INF/" + metainfFileName:        0,
+	}
+	seen := map[string]bool{}
+	for _, entry := range parseStream(t, device.sent.Bytes()) {
+		if entry.flags != 0 {
+			t.Errorf("%s: general purpose flags %#x, want 0 (no data descriptor)", entry.name, entry.flags)
+		}
+		if strings.HasSuffix(entry.name, "/") {
+			if entry.method != 0 || entry.size != 0 || len(entry.data) != 0 {
+				t.Errorf("%s: directory entry has method %d and %d bytes", entry.name, entry.method, entry.size)
+			}
+			continue
+		}
+		var content []byte
+		switch entry.method {
+		case 0:
+			if entry.compressedSize != entry.size {
+				t.Errorf("%s: stored with compressed size %d != size %d", entry.name, entry.compressedSize, entry.size)
+			}
+			content = entry.data
+		case 8:
+			if entry.compressedSize >= entry.size {
+				t.Errorf("%s: deflated to %d bytes, not smaller than %d", entry.name, entry.compressedSize, entry.size)
+			}
+			inflated, err := io.ReadAll(flate.NewReader(bytes.NewReader(entry.data)))
+			if err != nil {
+				t.Fatalf("%s: inflate: %v", entry.name, err)
+			}
+			content = inflated
+		default:
+			t.Fatalf("%s: unexpected compression method %d", entry.name, entry.method)
+		}
+		if uint32(len(content)) != entry.size {
+			t.Errorf("%s: header size %d, content %d bytes", entry.name, entry.size, len(content))
+		}
+		if crc32.ChecksumIEEE(content) != entry.crc {
+			t.Errorf("%s: CRC mismatch", entry.name)
+		}
+		if want, ok := wantMethods[entry.name]; ok {
+			seen[entry.name] = true
+			if entry.method != want {
+				t.Errorf("%s: compression method %d, want %d", entry.name, entry.method, want)
+			}
+		}
+		if want, ok := files[entry.name]; ok && !bytes.Equal(content, want) {
+			t.Errorf("%s: content differs from the source file", entry.name)
+		}
+	}
+	for name := range wantMethods {
+		if !seen[name] {
+			t.Errorf("%s was not sent", name)
+		}
+	}
+}
